<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OnHandTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#FFD100</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:listViewStyle">@style/OnHandListView</item>
    </style>

    <style name="OnHandListView" parent="@android:style/Widget.Material.ListView">
        <item name="android:background">#062B16</item>
        <item name="android:divider">#FFD100</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:listSelector">@drawable/onhand_list_selector</item>
        <item name="android:cacheColorHint">#062B16</item>
    </style>
</resources>
